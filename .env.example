# Variables de entorno de PUPE. En el servidor van en /etc/pupe/pupe.env (permisos 600).
# Importante: systemd no acepta comentarios al final de una línea; déjalos en su propia línea.

NODE_ENV=production

# Solo local: cloudflared es el único que se conecta. Cambia PORT si tu otra app ya lo usa.
HOST=127.0.0.1
PORT=3000

# Dirección pública. Debe empezar con https:// y no llevar ruta.
PUBLIC_URL=https://pupe.tudominio.com

# PostgreSQL: URL completa (paso 2 de DEPLOY.md). Usa una contraseña solo con letras y números.
DATABASE_URL=postgres://pupe:CAMBIA_ESTA_CONTRASENA@127.0.0.1:5432/pupe

# Cloudflare Turnstile (panel de Cloudflare → Turnstile → Add widget).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Correo saliente para los códigos de verificación del registro (paso 4b de DEPLOY.md).
# Los cuatro (HOST, USER, PASS, FROM) son obligatorios en producción. Con Brevo, SMTP_USER es el
# "Login" de SMTP y API → SMTP (…@smtp-brevo.com). Puerto 587 = STARTTLS, 465 = TLS directo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PUPE CU2 <no-responder@tudominio.com>

# Detrás de Cloudflare: cookie solo por HTTPS e IP real desde CF-Connecting-IP.
COOKIE_SECURE=true
TRUST_CLOUDFLARE=true

# false = empieza vacío (solo los 15 edificios) y sin cuentas demo.
# true  = datos y cuentas de demostración. Úsalo solo para presentar.
DEMO_MODE=false
# Contraseña de las cuentas demo. Obligatoria si DEMO_MODE=true (mínimo 10 caracteres).
# Solo se aplica la primera vez que arranca con la base vacía o al usar "Restablecer demo".
DEMO_PASSWORD=

# Opcionales: duración de la sesión en horas, intentos antes de bloquear,
# minutos de bloqueo e intentos de login/registro por IP cada 15 minutos.
SESSION_HOURS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
AUTH_RATE_LIMIT=20
